{
  "name": "physician-app",
  "sourceRoot": "apps/physician-app/src",
  "projectType": "application",
  "tags": [
    "scope:app",
    "type:physician-app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/physician-app"
      ],
      "options": {
        "command": "vite build",
        "cwd": "apps/physician-app"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/physician-app"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/physician-app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/physician-app"
      }
    }
  }
}
