VITE_AUTH_MODE=dev
VITE_OBSERVABILITY_MODE=dev
VITE_API_BASE_URL=/api

# --- Video consultation (WebRTC) ---
# Signaling server (video-consultation-service). BOTH the physician and patient apps must point at
# the SAME signaling host so a doctor and patient meet in the same room. Default is localhost:8130
# for single-machine dev; for cross-network set this to the signaling host's reachable address,
# e.g. wss://signal.example.com/ws (use wss:// behind TLS).
VITE_VIDEO_WS_URL=ws://localhost:8130/ws

# ICE servers for NAT traversal so the call works across different networks (not just a shared LAN).
# STUN (public Google servers) is the default and covers most home/office NATs.
# VITE_STUN_URL=stun:stun.l.google.com:19302
#
# TURN relay — REQUIRED for calls between restrictive/symmetric NATs where a direct path fails.
# Point these at your TURN server (e.g. coturn). Without a TURN server, some cross-network calls
# will not connect even with STUN.
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=telemedicine
# VITE_TURN_CREDENTIAL=change-me
